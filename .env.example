# 品品 / Pinpin —— 环境变量示例。复制为 .env 后填入你自己的值。
# .env 已被 .gitignore 排除，绝不要提交真实凭据。

# ── 飞书（Lark）企业自建应用凭据（应用 1 = primary，字段无后缀；多应用见下）──
FEISHU_APP_ID=your-app-id-here
FEISHU_APP_SECRET=your-app-secret-here
# 应用标签：日志 / 群列表标签 / vault 环境档案文件名（vault/环境/<标签>.md）；缺省 app1
FEISHU_APP_LABEL=main
# OWNER 鉴权用：你在该应用下的飞书 open_id（危险操作/重启/下线等仅 OWNER 可触发）
FEISHU_OWNER_OPEN_ID=ou_xxx

# ── 已知用户映射（contact API 查不到的成员手动补；JSON 或 "ou_xxx:名字,ou_yyy:名字" 两种格式）──
FEISHU_KNOWN_USERS={"ou_xxx":"User A","ou_yyy":"User B"}
# 群里其它 bot 花名册（cli_号:友好名；圈 bot 时用）
FEISHU_BOT_ROSTER={"cli_xxx":"BotA"}
# 同级放行名单（ou_xxx:名字,…）：这些人的文件读写 / 命令执行请求与 OWNER 同级放行；
# 控制本体的重启 / 下线 / 压缩 / 解散群仍仅 OWNER。留空 = 权限段不出现该档
FEISHU_PEER_USERS=ou_zzz:User C
# 只服务这些 chat（逗号分隔 chat_id）；留空 = 该应用可见的所有群 / 私聊全放行
FEISHU_CHAT_ALLOWLIST=
# 该应用所有频道默认外挂的知识目录（; 分隔绝对路径；频道自己配了 addDirs 则以频道为准）
FEISHU_ADD_DIRS=
# OWNER 本人在该应用所在组织的 lark-cli 用户身份目录（仅 OWNER 私聊频道用）；留空 = lark-cli 默认 ~/.lark-cli
LARK_USER_CONFIG_DIR=

# ── 多应用：一个启动器同时挂 N 个飞书自建应用（N = 2..9）——上面全部 FEISHU_* / LARK_USER_CONFIG_DIR 字段加 _N 后缀即可。
#    每个 chat 只归属一个应用；跨应用能力（全应用群列表 / 频道间捎话）只在 Supervisor 层，子进程只拿到所属应用的凭据 ──
FEISHU_APP_ID_2=
FEISHU_APP_SECRET_2=
FEISHU_APP_LABEL_2=second
FEISHU_OWNER_OPEN_ID_2=ou_xxx
FEISHU_KNOWN_USERS_2=
FEISHU_BOT_ROSTER_2=
FEISHU_PEER_USERS_2=
FEISHU_CHAT_ALLOWLIST_2=oc_xxx,oc_yyy
FEISHU_ADD_DIRS_2=/path/to/knowledge-dir
LARK_USER_CONFIG_DIR_2=/path/to/lark-cli-user-2

# ── 多频道 chat_id（决定 cron 归属：茶水间 = 日记 / 早报；OWNER 单聊 = 记忆自检 / 文档探针）──
PINPIN_TEA_CHAT_ID=oc_xxx
PINPIN_OWNER_CHAT_ID=oc_yyy

# ── 路径 / 运行参数 ──
# Obsidian vault 根目录（品品的人格 / 记忆内容都在这里，不在代码仓）
BASE_PROJECT_DIR=/path/to/obsidian-vault
PINPIN_VAULT_DIR=/path/to/obsidian-vault
PINPIN_VAULT_CWD=/path/to/obsidian-vault
# 关注事项早报的任务清单文件
DAILY_BRIEFING_TASK_FILE=/path/to/briefing-tasks.md
# 飞书消息轮询间隔（毫秒）
PINPIN_POLL_INTERVAL_MS=8000
# claude CLI 可执行文件路径（缺省走 `where claude.exe` / `which claude`）
PINPIN_CLAUDE_PATH=

# ── 第三方 ──
# ElevenLabs（TTS / STT）API key
ELEVENLABS_API_KEY=your-api-key-here

# ── 频道与探针 ──
# 新私聊默认睡眠的豁免名单（open_id CSV；这些人的私聊频道常驻）
PINPIN_P2P_ALWAYS_ON_OPEN_IDS=
# 文档探针只在此应用 label 的 owner 私聊频道注册（缺省按代码内默认值）
PINPIN_DOCWATCH_APP_LABEL=
