# 品品 / Pinpin —— 环境变量示例。复制为 .env 后填入你自己的值。
# .env 已被 .gitignore 排除，绝不要提交真实凭据。

# ── 飞书（Lark）企业自建应用凭据 ──
FEISHU_APP_ID=your-app-id-here
FEISHU_APP_SECRET=your-app-secret-here
# OWNER 鉴权用：你的飞书 open_id（危险操作/重启/下线等仅 OWNER 可触发）
FEISHU_OWNER_OPEN_ID=ou_xxx
# OAuth 回调地址（飞书任务授权用）
FEISHU_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# ── 已知用户映射（contact API 查不到的成员手动补；JSON 或 "ou_xxx:名字,ou_yyy:名字" 两种格式）──
FEISHU_KNOWN_USERS={"ou_xxx":"User A","ou_yyy":"User B"}
# 群里其它 bot 花名册（cli_号:友好名；圈 bot 时用）
FEISHU_BOT_ROSTER={"cli_xxx":"BotA"}

# ── 多频道 chat_id（决定 cron 归属：茶水间 / OWNER 单聊）──
PINPIN_TEA_CHAT_ID=oc_xxx
PINPIN_OWNER_CHAT_ID=oc_yyy

# ── 路径 / 运行参数 ──
# Obsidian vault 根目录（品品的人格 / 记忆 / 心境内容都在这里，不在代码仓）
BASE_PROJECT_DIR=/path/to/obsidian-vault
PINPIN_VAULT_DIR=/path/to/obsidian-vault
PINPIN_VAULT_CWD=/path/to/obsidian-vault
# 关注事项早报的任务清单文件
DAILY_BRIEFING_TASK_FILE=/path/to/briefing-tasks.md
# 飞书消息轮询间隔（毫秒）
PINPIN_POLL_INTERVAL_MS=8000
# claude CLI 可执行文件路径（缺省走 `where claude.exe` / `which claude`）
PINPIN_CLAUDE_PATH=

# ── 第三方 ──
# ElevenLabs（TTS / STT）API key
ELEVENLABS_API_KEY=your-api-key-here
