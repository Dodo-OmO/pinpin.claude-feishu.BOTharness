{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@supervisor/*": ["../supervisor/*"],
      "@ipc/*": ["../src/ipc/*"]
    }
  },
  "include": [
    "main/**/*",
    "preload/**/*",
    "renderer/**/*",
    "../supervisor/**/*",
    "../src/ipc/**/*"
  ],
  "exclude": ["node_modules", "../dist", "../out"]
}
